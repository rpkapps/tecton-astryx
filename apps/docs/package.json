{
  "name": "@tecton/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for the Tecton design system.",
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "dev": "pnpm generate && vite",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist src/generated node_modules/.vite"
  },
  "dependencies": {
    "@tecton/react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
